DATABASE_URL=postgresql://feed_catalog:feed_catalog@localhost:5432/feed_catalog

# Where Dagster keeps its instance config, run storage and logs. Must be a
# directory the process can write; the image owns /app/dagster_home.
DAGSTER_HOME=

# Mobility Database refresh token, from https://mobilitydatabase.org account
# settings. Exchanged for a short-lived access token at the start of each run.
# Never commit a filled-in value.
MOBILITY_DB_REFRESH_TOKEN=

# A sibling checkout of https://github.com/transitland/transitland-atlas. Blank
# falls back to the GitHub tree API, which is what the cluster uses.
TRANSITLAND_ATLAS_PATH=../transitland-atlas

# Optional Socrata app token for the NTD GTFS weblinks dataset. The API answers
# without one today.
NTD_APP_TOKEN=

# Object storage for the published artifacts. Read by
# gtfs_zone_db_models.object_store, not by this repo's Settings, so the names are
# gtfs-zone-db-models's. This is the public bucket, not gtfs-feeds.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=data.gtfs.zone
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_REGION=garage

# Gatus external endpoint pushed after each successful publish. Blank URL skips
# the push, which is what local runs want.
GATUS_URL=
GATUS_TOKEN=
